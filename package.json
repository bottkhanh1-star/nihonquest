{
  "name": "nihon-quest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"fs.rmSync('.next', { recursive: true, force: true })\"",
    "db:prepare": "prisma generate && node scripts/patch-prisma-wasm.js && prisma migrate deploy",
    "setup": "npm run db:prepare && npm run db:seed",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/import-japanese-curriculum.ts",
    "import:curriculum": "tsx scripts/import-japanese-curriculum.ts",
    "import:unitcuments": "tsx scripts/import-unitcuments-knowledge.ts",
    "import:unitcuments:dry-run": "tsx scripts/import-unitcuments-knowledge.ts --dry-run",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && node scripts/patch-prisma-wasm.js",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "apk:sync": "npx cap sync android",
    "apk:build": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1"
  },
  "dependencies": {
    "@neon/config": "^1.8.4",
    "@neon/env": "^1.5.1",
    "@neondatabase/serverless": "^0.9.5",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/adapter-neon": "^5.18.0",
    "@prisma/adapter-pg": "^5.18.0",
    "@prisma/client": "5.18.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "2.4.3",
    "cloudflare": "^7.3.0",
    "gsap": "file:vendor/gsap",
    "msedge-tts": "^2.1.0",
    "next": "^14.2.35",
    "next-auth": "4.24.7",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.186.1",
    "web-push": "^3.6.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@opennextjs/cloudflare": "^1.15.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.12",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "8.4.39",
    "prisma": "5.18.0",
    "tailwindcss": "3.4.7",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "2.0.5"
  }
}

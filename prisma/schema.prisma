generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailVerified       DateTime?
  passwordHash        String?
  name                String?
  image               String?
  learningLevel       String    @default("N5")
  learningGoal        String    @default("TRAVEL")
  dailyGoalMinutes    Int       @default(15)
  levelChoice         String    @default("N5")
  focusSkill          String    @default("BALANCED")
  learningStyle       String    @default("STRUCTURED")
  timezone            String    @default("UTC")
  theme               String    @default("system")
  soundEnabled        Boolean   @default(true)
  onboardingCompleted Boolean   @default(false)
  totalXP             Int       @default(0)
  level               Int       @default(1)
  currentStreak       Int       @default(0)
  longestStreak       Int       @default(0)
  lastActivityAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  accounts            Account[]
  sessions            Session[]
  profile             Profile?
  lessonProgress      UserLessonProgress[]
  exerciseAttempts    ExerciseAttempt[]
  xpTransactions      XpTransaction[]
  reviewItems         ReviewItem[]
  reviewHistory       ReviewHistory[]
  dailyMissions       UserDailyMission[]
  achievements        UserAchievement[]
  journeyProgress     UserJourneyProgress[]
  scenarioProgress    UserScenarioProgress[]
  collection          UserCollection[]
  roomItems           UserRoomItems[]
  aiConversations     AiConversation[]
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  avatar      String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// CONTENT_MODELS

model Kana {
  id        String       @id @default(cuid())
  character String
  script    String
  romaji    String
  ipa       String?
  mora      Int          @default(1)
  row       String
  column    String?
  audioUrl  String?
  kind      String       @default("BASIC")
  strokes   KanaStroke[]
  @@unique([character, script])
  @@index([script])
  @@index([romaji])
}

model KanaStroke {
  id     String @id @default(cuid())
  kanaId String
  order  Int
  path   String
  kana   Kana   @relation(fields: [kanaId], references: [id], onDelete: Cascade)
  @@unique([kanaId, order])
}

model Kanji {
  id          String         @id @default(cuid())
  character   String         @unique
  meaning     String
  strokeCount Int
  jlptLevel   String         @default("N5")
  grade       Int?
  readings    KanjiReading[]
  @@index([jlptLevel])
}

model KanjiReading {
  id      String @id @default(cuid())
  kanjiId String
  reading String
  type    String
  kanji   Kanji  @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  @@index([kanjiId])
}

model Vocabulary {
  id           String              @id @default(cuid())
  word         String
  kana         String
  kanji        String?
  romaji       String
  meaning      String
  partOfSpeech String              @default("noun")
  jlptLevel    String              @default("N5")
  audioUrl     String?
  tags         String              @default("")
  examples     VocabularyExample[]
  @@index([jlptLevel])
  @@index([kana])
  @@index([word, jlptLevel])
}

model VocabularyExample {
  id           String     @id @default(cuid())
  vocabularyId String
  japanese     String
  meaning      String
  romaji       String?
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  @@index([vocabularyId])
}

model Grammar {
  id             String           @id @default(cuid())
  title          String
  level          String           @default("N5")
  meaning        String
  structure      String
  commonMistakes String?
  examples       GrammarExample[]
  @@index([level])
}

model GrammarExample {
  id        String  @id @default(cuid())
  grammarId String
  japanese  String
  meaning   String
  romaji    String?
  grammar   Grammar @relation(fields: [grammarId], references: [id], onDelete: Cascade)
  @@index([grammarId])
}

model Lesson {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  description String
  level       String              @default("N5")
  order       Int                 @default(0)
  xpReward    Int                 @default(50)
  isPublished Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       LessonItem[]
  exercises   Exercise[]
  progress    UserLessonProgress[]
  @@index([level])
  @@index([order])
}

model LessonItem {
  id          String @id @default(cuid())
  lessonId    String
  order       Int
  contentType String
  contentId   String
  instruction String?
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@index([lessonId, order])
}

model Exercise {
  id            String           @id @default(cuid())
  lessonId      String?
  contentType   String?
  contentId     String?
  type          String
  question      String
  prompt        String?
  audioUrl      String?
  correctAnswer String
  points        Int              @default(10)
  order         Int              @default(0)
  lesson        Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  options       ExerciseOption[]
  attempts      ExerciseAttempt[]
  @@index([lessonId])
}

model ExerciseOption {
  id         String   @id @default(cuid())
  exerciseId String
  label      String
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  @@index([exerciseId])
}
// USERSTATE_MODELS

model UserLessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  status      String    @default("IN_PROGRESS")
  score       Int?
  accuracy    Float?
  completedAt DateTime?
  startedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model ExerciseAttempt {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  lessonId   String?
  isCorrect  Boolean
  userAnswer String
  timeSpent  Int      @default(0)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([exerciseId])
  @@index([userId, createdAt])
  @@index([userId, lessonId])
}

model XpTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  reason      String
  referenceId String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([reason])
  @@index([userId, createdAt])
  @@index([userId, reason, referenceId])
}

model ReviewItem {
  id             String          @id @default(cuid())
  userId         String
  contentType    String
  contentId      String
  ease           Float           @default(2.5)
  interval       Int             @default(0)
  repetitions    Int             @default(0)
  dueAt          DateTime        @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  history        ReviewHistory[]
  @@unique([userId, contentType, contentId])
  @@index([userId, dueAt])
}

model ReviewHistory {
  id           String      @id @default(cuid())
  userId       String
  reviewItemId String?
  contentType  String
  contentId    String
  grade        String
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewItem   ReviewItem? @relation(fields: [reviewItemId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([reviewItemId])
  @@index([userId, createdAt])
  @@index([userId, grade])
}

model DailyMission {
  id          String             @id @default(cuid())
  key         String             @unique
  title       String
  description String
  xpReward    Int                @default(20)
  targetCount Int                @default(1)
  type        String             @default("LESSON")
  userEntries UserDailyMission[]
}

model UserDailyMission {
  id          String       @id @default(cuid())
  userId      String
  missionId   String
  date        String
  progress    Int          @default(0)
  targetCount Int          @default(1)
  status      String       @default("IN_PROGRESS")
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     DailyMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  @@unique([userId, missionId, date])
  @@index([userId, date])
}

model Achievement {
  id          String            @id @default(cuid())
  key         String            @unique
  title       String
  description String
  icon        String            @default("star")
  xpReward    Int               @default(50)
  requirement String            @default("{}")
  holders     UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  @@unique([userId, achievementId])
  @@index([userId])
}
//__TAIL__

model JourneyLocation {
  id              String                @id @default(cuid())
  slug            String                @unique
  name            String
  nameJa          String
  description     String
  order           Int                   @default(0)
  imageUrl        String?
  xpReward        Int                   @default(100)
  requirementXp   Int                   @default(0)
  requirementJson String                @default("{}")
  userProgress    UserJourneyProgress[]
  @@index([order])
}

model UserJourneyProgress {
  id          String          @id @default(cuid())
  userId      String
  locationId  String
  status      String          @default("LOCKED")
  progress    Int             @default(0)
  isStamped   Boolean         @default(false)
  stampedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  location    JourneyLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  @@unique([userId, locationId])
  @@index([userId])
}

model Scenario {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  title       String
  description String
  level       String                 @default("N5")
  xpReward    Int                    @default(60)
  isPublished Boolean                @default(true)
  messages    ScenarioMessage[]
  choices     ScenarioChoice[]
  progress    UserScenarioProgress[]
}

model ScenarioMessage {
  id         String   @id @default(cuid())
  scenarioId String
  order      Int
  speaker    String   @default("NPC")
  japanese   String
  romaji     String?
  meaning    String?
  audioUrl   String?
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  @@index([scenarioId, order])
}

model ScenarioChoice {
  id            String   @id @default(cuid())
  scenarioId    String
  messageId     String?
  optionText    String
  nextMessageId String?
  isIdeal       Boolean  @default(false)
  xpReward      Int      @default(0)
  scenario      Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  @@index([scenarioId])
}

model UserScenarioProgress {
  id               String    @id @default(cuid())
  userId           String
  scenarioId       String
  currentMessageId String?
  status           String    @default("IN_PROGRESS")
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario         Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  @@unique([userId, scenarioId])
  @@index([userId])
}

model CollectionItem {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  nameJa      String?
  description String
  imageUrl    String?
  rarity      String           @default("COMMON")
  category    String           @default("SOUVENIR")
  holders     UserCollection[]
}

model UserCollection {
  id         String         @id @default(cuid())
  userId     String
  itemId     String
  obtainedAt DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@unique([userId, itemId])
  @@index([userId])
}

model RoomItem {
  id          String          @id @default(cuid())
  key         String          @unique
  name        String
  description String
  imageUrl    String?
  holders     UserRoomItems[]
}

model UserRoomItems {
  id         String   @id @default(cuid())
  userId     String
  roomItemId String
  posX       Int      @default(0)
  posY       Int      @default(0)
  placed     Boolean  @default(false)
  obtainedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomItem   RoomItem @relation(fields: [roomItemId], references: [id], onDelete: Cascade)
  @@unique([userId, roomItemId])
  @@index([userId])
}

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String?
  provider  String      @default("UNCONFIGURED")
  model     String      @default("none")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
  @@index([userId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId])
}

model DocumentResource {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  fileName         String
  relativePath     String   @unique
  ext              String
  sizeBytes        Int      @default(0)
  sha256           String
  level            String   @default("N5")
  category         String   @default("REFERENCE")
  preImportStatus  String   @default("NOT_IMPORTED")
  importStatus     String   @default("IMPORTED")
  accessPolicy     String   @default("VIEW_ONLY")
  isDuplicate      Boolean  @default(false)
  duplicateOf      String?
  copyrightNote    String?
  description      String?
  audioDurationSec Int?
  transcript       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([level])
  @@index([category])
  @@index([sha256])
}

model AssessmentExam {
  id              String                   @id @default(cuid())
  slug            String                   @unique
  title           String
  description     String
  kindLabel       String                   @default("Kiểm tra năng lực")
  category        String                   @default("LEVEL_TEST")
  targetLevel     String                   @default("N5")
  skillFocus      String                   @default("ALL")
  timeMinutes     Int                      @default(15)
  icon            String                   @default("📝")
  badge           String                   @default("JLPT")
  sourceDocument  String?
  answerAuthority String                   @default("CURATED")
  isPublished     Boolean                  @default(true)
  order           Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  questions       AssessmentExamQuestion[]
  @@index([targetLevel])
  @@index([category])
  @@index([order])
}

model AssessmentExamQuestion {
  id                     String         @id @default(cuid())
  examId                 String
  questionKey            String
  order                  Int            @default(0)
  skill                  String         @default("READING")
  subCategory            String         @default("Đọc hiểu")
  level                  String         @default("N5")
  format                 String         @default("MULTIPLE_CHOICE")
  question               String
  contextPassage         String?
  audioUrl               String?
  audioScript            String?
  promptHint             String?
  optionsJson            String         @default("[]")
  acceptedKeywordsJson   String         @default("[]")
  sampleAnswer           String?
  rubricCriteriaJson     String         @default("[]")
  explanation            String
  recommendedLessonSlug  String         @default("n5-lesson-01")
  recommendedLessonTitle String         @default("Bài học gợi ý")
  recommendedLessonTopic String         @default("Ôn tập kiến thức")
  exam                   AssessmentExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  @@unique([examId, questionKey])
  @@index([examId, order])
}

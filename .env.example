# ==============================================================================
# Nihon Quest — Environment Variables Template
# Copy this file to .env and fill in the actual configuration values:
# cp .env.example .env
# ==============================================================================

# 1. PostgreSQL Database (Required)
# A) Supabase PostgreSQL (KHUYÊN DÙNG NHẤT — Không cần thẻ tín dụng, Ping Singapore siêu nhanh ~25ms):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
#
# B) Oracle Cloud Always Free ARM PostgreSQL (200GB SSD):
# DATABASE_URL="postgresql://nihonquest_admin:YourStrongPassword@<YOUR_ORACLE_VM_IP>:5432/nihonquest?sslmode=prefer"
# DIRECT_URL="postgresql://nihonquest_admin:YourStrongPassword@<YOUR_ORACLE_VM_IP>:5432/nihonquest?sslmode=prefer"
#
# C) Local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nihonquest?sslmode=disable"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nihonquest?sslmode=disable"

# 2. NextAuth Authentication (Required in Production — minimum 32 characters)
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-secure-random-32-character-secret"
NEXTAUTH_URL="http://localhost:3000"

# 3. Google OAuth (Optional)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 4. SMTP Email for OTP Registration & Password Recovery (Optional in Dev)
# In development without SMTP credentials, OTP codes are logged to server console.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Nihon Quest <no-reply@nihonquest.local>"

# 5. AI Kaiwa Sensei Providers (Optional — falls back to built-in local N5-N3 engine)
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
# Set to "true" only if you explicitly allow users to supply their own API keys from the UI
ALLOW_CLIENT_AI_KEYS="false"

# 6. Distributed Rate Limiting via Upstash Redis REST (Optional — recommended for Vercel/Serverless)
# Falls back to bounded per-instance in-memory rate limiting when unset.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# 7. Supabase Client SDK & Storage Configuration
NEXT_PUBLIC_SUPABASE_URL="https://gzsvingppjnnjizevdmd.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_MgxQMeMYgFj4MXCZnGQS0g_Tg5J6OGt"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_MgxQMeMYgFj4MXCZnGQS0g_Tg5J6OGt"
